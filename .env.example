# ============ 数据库 ============
# MySQL 连接串；密码含特殊字符时需按 URL 编码（@ -> %40）
DATABASE_URL=mysql+pymysql://pkma:your_password@127.0.0.1:3306/pkma?charset=utf8mb4
AUTO_CREATE_TABLES=true

# ============ 生成模型（OpenAI 兼容接口） ============
# 例：https://open.bigmodel.cn/api/paas/v4 或 https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE_CHAT=0.5
LLM_TEMPERATURE_EXTRACT=0.15
LLM_MAX_TOKENS_CHAT=1024
LLM_THINKING=disabled

# ============ 向量模型 ============
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=auto
# 有 NVIDIA 显卡时 auto 会自动使用 CUDA；无卡则回退 CPU
# CPU 模式下 EMBEDDING_THREADS 控制占用核心数，避免整机卡顿
EMBEDDING_BATCH_SIZE=64
# 向量化使用的 CPU 线程数，过大（如等于逻辑核数）会占满整机导致卡顿
EMBEDDING_THREADS=4
HF_ENDPOINT=https://hf-mirror.com

# ============ 存储 ============
DATA_DIR=./data
# 留空时上传目录落到 DATA_DIR/uploads
UPLOAD_DIR=
# 向量库目录：留空默认 %USERPROFILE%\.pkma\chroma
# 必须使用纯英文路径 —— Chroma 在含中文的路径下写入较大索引会丢失 HNSW 数据
CHROMA_DIR=

# ============ 入库与检索 ============
MAX_UPLOAD_MB=40
# 入库闸门：字数为主闸门（150 万字 ≈ 3.5 分钟向量化），1–1.5 倍提示可 force，超 1.5 倍拒绝
MAX_DOCUMENT_CHARS=3000000
MAX_DOCUMENT_CHARS_HARD=4500000
# 页数只提示不拦截；切片数仅作护栏
MAX_DOCUMENT_PAGES_WARN=1200
MAX_DOCUMENT_CHUNKS=12000
# 字数÷页数低于该值判定为疑似扫描件
SCANNED_CHARS_PER_PAGE=50
# 同时入库的任务数，>1 会争抢同一块 GPU
MAX_CONCURRENT_INGEST=1
ALLOWED_EXTENSIONS=pdf,docx,txt
CHUNK_UNIT=token
CHUNK_TOKENS=480
CHUNK_OVERLAP_TOKENS=64
PARENT_CHILD_ENABLED=true
CHUNK_CHILD_TOKENS=160
CHUNK_CHILD_OVERLAP=32
QUERY_UNDERSTANDING_ENABLED=true
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# 超大文档保护：超出后直接报错，避免长时间占用 CPU
MAX_DOCUMENT_PAGES=600
INGEST_BATCH_SIZE=128
RETRIEVAL_TOP_K=8
CONTEXT_TOP_K=5
RELEVANCE_THRESHOLD=0.45
GRAPH_EXPANSION_ENABLED=true

# ============ 服务 ============
ENVIRONMENT=dev
HOST=127.0.0.1
PORT=8000
